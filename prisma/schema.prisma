generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(MANAGER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deals        Deal[]   @relation("ResponsibleDeals")
  comments     Comment[]
}

enum Role {
  ADMIN
  MANAGER
}

// ─────────────────────────────────────────────
// DEALS (core entity)
// ─────────────────────────────────────────────

model Deal {
  id               String      @id @default(cuid())
  title            String
  stage            DealStage   @default(NEW)
  status           DealStatus?
  source           Source?

  responsibleId    String
  responsible      User        @relation("ResponsibleDeals", fields: [responsibleId], references: [id])

  // Financials
  budgetClient     Float?
  budgetContractor Float?
  profit           Float?
  managerProfit    Float?

  // Scheduling
  orderDate        DateTime?
  reminderDate     DateTime?
  reminderTime     String?

  // Client contact
  contactName      String?
  contactPhone     String?
  contactEmail     String?
  contactTelegram  String?

  // Contractor
  contractorName   String?
  contractorPhone  String?
  contractorTgHandle String?

  // Address
  address          String?
  city             String      @default("SPB")

  // Meta
  tags             String[]
  notes            String?

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  completedAt      DateTime?

  // External integrations
  amoLeadId        BigInt?     @unique
  source_system    String?     // "amo" | "manual" | null

  files            DealFile[]
  comments         Comment[]
  activities       Activity[]
}

enum DealStage {
  NEW
  AWAITING_DECISION
  DEFERRED
  AGREED_FINDING
  IN_PROGRESS
  COMPLETED
  REFUSED
}

enum DealStatus {
  WAITING_ANSWER
  AGREED
  CALL
  CLARIFY
  WRITE
  WAITING_PHOTO
}

enum Source {
  AVITO
  WEBSITE
  REFERRAL
  RECURRING
  OTHER
}

// ─────────────────────────────────────────────
// FILES
// ─────────────────────────────────────────────

model DealFile {
  id           String   @id @default(cuid())
  dealId       String
  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  filename     String
  originalName String
  mimeType     String
  size         Int
  storageKey   String
  url          String

  createdAt    DateTime @default(now())
}

// ─────────────────────────────────────────────
// COMMENTS / ACTIVITY LOG
// ─────────────────────────────────────────────

model Comment {
  id        String           @id @default(cuid())
  dealId    String
  deal      Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  authorId  String
  author    User             @relation(fields: [authorId], references: [id])
  text      String
  channel   CommentChannel   @default(NOTE)
  direction CommentDirection?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

enum CommentChannel {
  NOTE
  TG
  AVITO
  MAX
  CALL
}

enum CommentDirection {
  IN
  OUT
}

model Activity {
  id        String       @id @default(cuid())
  dealId    String
  deal      Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type      ActivityType
  data      Json?
  userId    String?
  createdAt DateTime     @default(now())
}

enum ActivityType {
  STAGE_CHANGED
  FIELD_UPDATED
  FILE_UPLOADED
  COMMENT_ADDED
  TELEGRAM_SENT
}

// ─────────────────────────────────────────────
// ANALYTICS: EXPENSES
// ─────────────────────────────────────────────

model Expense {
  id          String   @id @default(cuid())
  name        String
  amount      Float
  category    ExpenseCategory
  date        DateTime
  notes       String?
  createdAt   DateTime @default(now())
}

enum ExpenseCategory {
  MARKETING
  SALARY
  SOFTWARE
  OTHER
}

// ─────────────────────────────────────────────
// INVOICES (выставление счетов через Точка-банк)
// ─────────────────────────────────────────────

model Invoice {
  id                  String   @id @default(cuid())
  number              Int
  date                DateTime

  counterpartyInn     String
  counterpartyName    String
  counterpartyKpp     String?
  counterpartyAddress String?

  serviceName String  @default("Услуги по уборке территории")
  unit        String  @default("Услуга")
  quantity    Float   @default(1)
  price       Float
  withVat     Boolean @default(false)
  total       Float

  tochkaId    String?
  pdfUrl      String?
  status      InvoiceStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}
